{
  "name": "billboard-planner",
  "version": "0.0.0",
  "private": true,
  "description": "Turn a vendor's billboard list into a live satellite map your whole team can read. Pins, photos, rates and distances in one shareable HTML file.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shashankshekharans/billboard-planner.git"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:example": "npm run build:example -w @billboard-planner/template"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
