{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": false,
    "types": ["vite/client"],
    "paths": {
      "@billboard-planner/core": ["../core/src/index.ts"],
      "@billboard-planner/cli/sheets": ["../cli/src/sheets.ts"],
      "@billboard-planner/template/render": ["../template/render.d.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
