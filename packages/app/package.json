    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "idb-keyval": "6.3.0",
    "papaparse": "5.7.0",
    "preact": "10.29.8",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@preact/preset-vite": "2.10.6",
    "@types/papaparse": "5.5.2",
    "vite": "8.3.4"
  }
}
