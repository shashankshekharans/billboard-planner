{
  "name": "@billboard-planner/app",
  "version": "0.0.0",
  "private": true,
  "description": "Browser app: start screen, bundled AAJ Swift example, plan editor and HTML export (GitHub Pages).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "copy-assets": "node scripts/copy-assets.mjs",
    "dev": "npm run copy-assets && vite",
